(()=>{'use strict';const host=document.getElementById('rbacTeacherBlock');if(!host)return;
async function api(p,method='GET',data){const r=await fetch('/api/school'+p,{method,credentials:'same-origin',cache:'no-store',headers:method==='GET'?{}:{'Content-Type':'application/json'},body:data?JSON.stringify(data):undefined});const out=await r.json().catch(()=>({}));if(!r.ok)throw Error(out.message||r.status);return out;}
const el=(tag,txt)=>{const e=document.createElement(tag);if(txt!==undefined)e.textContent=txt;return e;};
async function reload(){let data;try{data=await api('/admin/teachers');}catch(e){host.hidden=true;return;}host.hidden=false;const target=document.getElementById('teacherList');target.replaceChildren();const transfer=document.getElementById('transferTeacher');transfer.replaceChildren();for(const u of data.teachers){const option=el('option',u.username);option.value=u.id;transfer.append(option);}for(const t of data.teachers){const wrap=el('div');wrap.style='border-top:1px solid #e7e5f3;padding:14px 0;display:flex;flex-wrap:wrap;gap:10px;align-items:center';const name=el('strong',t.username);name.style='min-width:140px';const inp=el('input');inp.value=t.classes.join('、');inp.setAttribute('aria-label',t.username+'任教班级');inp.placeholder='七年级1班、七年级2班';inp.style='flex:1;min-width:260px';const save=el('button','保存班级权限');save.className='light small';save.onclick=async()=>{try{const classes=inp.value.split(/[,，、\n]+/).map(s=>s.trim()).filter(Boolean);await api('/admin/teachers/'+encodeURIComponent(t.id)+'/classes','POST',{classes});alert('权限已保存，立即生效');await reload();}catch(e){alert(e.message);}};wrap.append(name,inp,save);target.append(wrap);}if(!data.teachers.length)target.textContent='目前没有教师账号。先在下方创建一个教师账号。';const hint=document.getElementById('teacherClassHint');hint.textContent='目前学生班级：'+(data.classes.join('、')||'暂无。可先导入学生账号。');}
document.getElementById('transferAssignmentForm').onsubmit=async(e)=>{e.preventDefault();try{await api('/admin/assignments/'+document.getElementById('transferCode').value.trim().toUpperCase()+'/owner','POST',{teacherId:document.getElementById('transferTeacher').value,className:document.getElementById('transferClass').value.trim()});alert('任务已移交，教师重新进入后台即可看到');}catch(ex){alert(ex.message);}};
document.getElementById('createTeacherForm').onsubmit=async(e)=>{e.preventDefault();const u=document.getElementById('newTeacherUser').value.trim(),p=document.getElementById('newTeacherPass').value;try{const r=await fetch('/api/admin/users',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({username:u,password:p,role:'teacher'})});const result=await r.json().catch(()=>({}));if(!r.ok)throw Error(result.message||'创建失败');e.target.reset();alert('教师账号创建成功，请在下方分配任教班级；未分配时没有学生数据权限。');await reload();}catch(ex){alert(ex.message);}};
reload();})();
