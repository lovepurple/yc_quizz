(()=>{'use strict';const $=s=>document.getElementById(s);let classes=[],teachers=[],selectedTeacher='',busy=false;
const api=async(path,method='GET',body)=>{const r=await fetch('/api/school'+path,{credentials:'same-origin',cache:'no-store',method,headers:method==='GET'?{}:{'Content-Type':'application/json'},body:body?JSON.stringify(body):undefined});let data;try{data=await r.json()}catch{data={}}if(!r.ok)throw Error(data.message||('服务器返回 '+r.status));return data;};
function flash(text,error=false){const el=$('flash');el.hidden=false;el.classList.toggle('error',error);el.textContent=text;el.scrollIntoView({block:'nearest',behavior:'smooth'});}
const el=(tag,text)=>{const out=document.createElement(tag);if(text!==undefined)out.textContent=text;return out;};
const btn=(name,fn)=>{const b=el('button',name);b.type='button';b.className='btn ghost';b.addEventListener('click',fn);return b;};
function stageGrade(){return $('grade').value.trim();}
async function reload(){const [catalog,grantInfo]=await Promise.all([api('/admin/classes'),api('/admin/teachers')]);classes=catalog.classes||[];teachers=grantInfo.teachers||[];$('main').hidden=false;$('unauthed').hidden=true;const counts=[classes.length,classes.filter(c=>c.active).length,classes.reduce((a,c)=>a+c.studentCount,0),teachers.length],labels=['班级总数','启用班级','已导入学生','教师账号'];$('stats').replaceChildren();counts.forEach((n,i)=>{const box=el('div');box.className='stat';box.append(el('b',String(n)),el('span',labels[i]));$('stats').append(box);});renderList();renderTeacher();}
function renderList(){const tb=$('classesBody');tb.replaceChildren();const q=$('filter').value.trim().toLowerCase(),s=$('filterStage').value;const data=classes.filter(c=>(!q||[c.name,c.grade].some(x=>String(x||'').toLowerCase().includes(q)))&&(!s||s===c.stage)&&($('showInactive').checked||c.active));data.sort((a,b)=>a.stage.localeCompare(b.stage,'zh-CN')||a.name.localeCompare(b.name,'zh-CN',{numeric:true}));for(const c of data){const tr=el('tr');[c.name,c.stage+' / '+(c.grade||'—'),String(c.studentCount),String(c.teacherIds.length),String(c.taskCount)].forEach(x=>tr.append(el('td',x)));const status=el('td');const pill=el('span',c.active?'启用':'停用');pill.className='state '+(c.active?'active':'inactive');status.append(pill);tr.append(status);const action=el('td');action.append(btn('编辑',()=>edit(c)),btn(c.active?'停用':'启用',()=>toggle(c)),btn('删除',()=>remove(c)));tr.append(action);tb.append(tr);}if(!data.length){const tr=el('tr'),td=el('td','暂无符合条件的班级');td.colSpan=7;tr.append(td);tb.append(tr);}}
async function edit(c){const name=prompt('班级名称（已有学生、测验或教师的班级不可更名）',c.name);if(name===null)return;const grade=prompt('年级名称',c.grade||'');if(grade===null)return;try{await api('/admin/classes/'+encodeURIComponent(c.id),'PATCH',{name:name.trim(),grade:grade.trim()});flash('已保存班级资料');await reload();}catch(e){flash(e.message,true);}}
async function toggle(c){if(!confirm('确定'+(c.active?'停用':'启用')+'「'+c.name+'」？停用仅阻止新学生导入与新任务发布，不会删除旧成绩。'))return;try{await api('/admin/classes/'+encodeURIComponent(c.id),'PATCH',{active:!c.active});flash('班级状态已更新');await reload();}catch(e){flash(e.message,true);}}
async function remove(c){if(!confirm('永久删除空班级「'+c.name+'」？已有学生、任务或任教教师的班级不能删除。'))return;try{await api('/admin/classes/'+encodeURIComponent(c.id),'DELETE');flash('空班级已删除');await reload();}catch(e){flash(e.message,true);}}
$('singleForm').addEventListener('submit',async e=>{e.preventDefault();try{await api('/admin/classes','POST',{name:$('className').value.trim(),stage:$('stage').value,grade:stageGrade()});flash('班级创建成功：'+$('className').value.trim());$('className').value='';await reload();}catch(err){flash(err.message,true);}});
$('buildBatch').onclick=()=>{const prefix=$('batchPrefix').value.trim();const first=Number($('batchFrom').value),last=Number($('batchTo').value);if(!prefix||!Number.isInteger(first)||!Number.isInteger(last)||first<1||last>99||first>last||last-first>=150){flash('班级序号应在1～99之间，顺序正确，单批最多150个',true);return;}$('batchText').value=Array.from({length:last-first+1},(_,i)=>prefix+(first+i)+'班').join('\n');$('csvInfo').textContent='已生成 '+(last-first+1)+' 个班级，请检查后点击确认批量创建。';};
const csvParse=txt=>{const out=[],row=[];let cell='',quote=false;for(let i=0;i<txt.length;i++){const c=txt[i];if(quote){if(c==='"'&&txt[i+1]==='"'){cell+='"';i++;}else if(c==='"')quote=false;else cell+=c;}else if(c==='"')quote=true;else if(c===','){row.push(cell);cell='';}else if(c==='\n'){row.push(cell.replace(/\r$/,''));out.push([...row]);row.length=0;cell='';}else cell+=c;}if(quote)throw Error('CSV文件存在未闭合的引号');if(cell||row.length){row.push(cell.replace(/\r$/,''));out.push(row);}return out;};
$('csvTemplate').onclick=()=>{const text='\uFEFF班级名称,学段,年级\r\n七年级1班,初中,七年级\r\n七年级2班,初中,七年级\r\n高一1班,高中,高一\r\n';const link=el('a');link.href=URL.createObjectURL(new Blob([text],{type:'text/csv;charset=utf-8'}));link.download='学校班级导入模板_UTF8.csv';link.click();setTimeout(()=>URL.revokeObjectURL(link.href),5000);};
$('csvFile').onchange=async()=>{const f=$('csvFile').files[0];if(!f)return;try{if(f.size>1024*512)throw Error('班级CSV不能超过512KB');const raw=await f.arrayBuffer();let text;try{text=new TextDecoder('utf-8',{fatal:true}).decode(raw)}catch{text=new TextDecoder('gb18030').decode(raw)}const lines=csvParse(text);const header=lines.shift().map(x=>x.replace(/^\uFEFF/,'').trim().toLowerCase()),index=['班级名称','学段','年级'].map(x=>header.indexOf(x));if(index[0]<0)throw Error('CSV表头至少需要“班级名称”');const names=lines.filter(row=>row.some(x=>x.trim())).map(row=>({name:row[index[0]]?.trim()||'',stage:index[1]<0?$('batchStage').value:row[index[1]].trim(),grade:index[2]<0?'':row[index[2]].trim()}));if(names.length>150)throw Error('单批最多150个班级，请拆分导入');$('batchText').value=names.map(x=>x.name).join('\n');$('csvInfo').textContent='文件已读取 '+names.length+' 个班级；点击确认创建。';window.__schoolCsvRows=names;}catch(e){window.__schoolCsvRows=null;flash(e.message,true);}};
$('batchText').addEventListener('input',()=>{window.__schoolCsvRows=null;});
$('submitBatch').onclick=async()=>{if(busy)return;const lines=$('batchText').value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);if(!lines.length){flash('先生成、粘贴或导入班级清单',true);return;}if(lines.length>150){flash('一次最多创建150个班级，请分批',true);return;}const rows=window.__schoolCsvRows?.length===lines.length?window.__schoolCsvRows:lines.map(name=>({name,stage:$('batchStage').value,grade:$('batchPrefix').value.trim()}));if(!confirm('即将创建 '+rows.length+' 个班级，重复名称会自动跳过。确认继续？'))return;busy=true;$('submitBatch').disabled=true;try{const r=await api('/admin/classes/batch','POST',{rows});flash('创建完成：新增 '+r.imported+' 个，跳过重复 '+r.skipped+' 个，格式错误 '+r.invalid.length+' 个'+(r.invalid.length?'（如第'+r.invalid[0].row+'行）':''));await reload();}catch(e){flash(e.message,true);}finally{busy=false;$('submitBatch').disabled=false;}};
function renderTeacher(){const select=$('teacherSelect'),prev=selectedTeacher;select.replaceChildren();for(const t of teachers){const op=el('option',t.username);op.value=t.id;select.append(op);}if(!teachers.length){selectedTeacher='';$('grantGrid').textContent='请先到原教师管理后台创建教师账号';return;}selectedTeacher=teachers.some(t=>t.id===prev)?prev:teachers[0].id;select.value=selectedTeacher;renderGrants();}
function renderGrants(){const t=teachers.find(x=>x.id===selectedTeacher),filter=$('teacherFilter').value.trim().toLowerCase();const grid=$('grantGrid');grid.replaceChildren();if(!t)return;for(const c of classes.filter(c=>!filter||c.name.toLowerCase().includes(filter)||c.grade.toLowerCase().includes(filter))){const label=el('label');label.className='grant';const check=el('input');check.type='checkbox';check.value=c.name;check.checked=(t.classes||[]).includes(c.name);check.dataset.classId=c.id;if(!c.active&&!check.checked)check.disabled=true;label.append(check,el('span',c.name+(c.active?'':'（停用）')));grid.append(label);}if(!grid.children.length)grid.textContent='暂无匹配的班级。';$('grantStatus').textContent='已授权 '+(t.classes||[]).length+' 个班级';}
$('teacherSelect').onchange=()=>{selectedTeacher=$('teacherSelect').value;renderGrants();};$('teacherFilter').oninput=()=>renderGrants();
$('saveGrants').onclick=async()=>{const t=teachers.find(x=>x.id===selectedTeacher);if(!t)return;const selected=new Set((t.classes||[]));for(const checkbox of $('grantGrid').querySelectorAll('input[type=checkbox]')){if(checkbox.checked)selected.add(checkbox.value);else selected.delete(checkbox.value);}const list=Array.from(selected);if(list.length>50){flash('原权限系统每位教师最多可管理50个班级',true);return;}try{await api('/admin/teachers/'+encodeURIComponent(t.id)+'/classes','POST',{classes:list});flash('已保存 '+t.username+' 的任教权限（共'+list.length+'个班级）');await reload();}catch(e){flash(e.message,true);}};
$('reload').onclick=()=>reload().catch(e=>flash(e.message,true));$('filter').oninput=renderList;$('filterStage').onchange=renderList;$('showInactive').onchange=renderList;
$('grade').oninput=()=>{if(!$('className').dataset.userEdited){$('className').value=$('grade').value.trim()+'1班';}};$('className').oninput=()=>$('className').dataset.userEdited='1';$('className').value='七年级3班';
reload().catch(e=>{$('main').hidden=true;$('unauthed').hidden=false;flash('当前无法加载班级目录：'+e.message,true);});
})();
