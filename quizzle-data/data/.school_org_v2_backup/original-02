:root{font-family:-apple-system,BlinkMacSystemFont,"Microsoft YaHei","PingFang SC",sans-serif;color:#182445;background:#f5f6fc;line-height:1.5}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 0% 0%,#e2dcff 0,transparent 37%),radial-gradient(circle at 97% 28%,#e7f5f0 0,transparent 23%),#f6f7fb}.app{max-width:1240px;margin:auto;padding:28px 26px 50px}.top{display:flex;justify-content:space-between;align-items:flex-start;gap:25px;margin-bottom:22px}.eyebrow{font-weight:700;color:#5c45c9;font-size:13px}.top h1{margin:9px 0 2px;font-size:32px}.top p{margin:4px 0;color:#607089;font-size:14px}.top nav{display:flex;gap:8px;flex-wrap:wrap}.card{background:white;border:1px solid #e6e7f2;border-radius:20px;padding:24px;margin:0 0 20px;box-shadow:0 11px 32px rgba(39,35,101,.055)}.cols{display:grid;grid-template-columns:1fr 1fr;gap:20px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:18px}.section-head h2{font-size:20px;margin:0}.chip{font-size:12px;font-weight:700;padding:5px 10px;border-radius:30px;background:#f1eeff;color:#6548d3}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}.stat{padding:18px 22px;background:white;border:1px solid #e7e6f4;border-radius:16px}.stat b{font-size:28px;color:#6245d5;display:block;line-height:1.25}.stat span{font-size:13px;color:#607089}label{display:block;font-weight:650;font-size:13px;color:#3c4767;margin-bottom:14px}input:not([type=checkbox]):not([type=file]),select,textarea{font:inherit;display:block;width:100%;margin-top:6px;border:1px solid #d6d8e9;border-radius:11px;padding:10px 12px;background:white;color:#152244;outline:none;min-width:0}input:focus,select:focus,textarea:focus{border-color:#7454ed;box-shadow:0 0 0 3px #ded7ff}.fieldrow{display:grid;grid-template-columns:1fr 1fr;gap:12px}.fieldrow label{margin:0 0 14px}textarea{resize:vertical}.fieldbtn{align-self:end;margin-bottom:14px}.btn,.upload{font:inherit;font-weight:700;font-size:14px;border:1px solid transparent;border-radius:11px;text-decoration:none;display:inline-block;padding:10px 15px;cursor:pointer;white-space:nowrap}.btn:disabled{opacity:.5;cursor:not-allowed}.solid{background:#6650df;color:white;box-shadow:0 4px 10px #5b44bc24}.outline{border-color:#9d8ff1;background:#f7f5ff;color:#5944b4}.ghost{border-color:#e0def8;background:#f6f5ff;color:#604bc4}.upload{color:#6148bd;background:#f6f4ff;border-color:#ddd7fe}.inline{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.help{color:#758197;font-weight:400;font-size:12px;margin:10px 0}.toolbar{display:flex;align-items:center;gap:12px;margin-bottom:15px;flex-wrap:wrap}.toolbar input{flex:1;max-width:420px;margin:0!important}.toolbar select{width:160px;margin:0}.check{margin:0;white-space:nowrap}.check input{accent-color:#694de1}.tablewrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:14px}thead{background:#f6f5fb}th{text-align:left;padding:12px;white-space:nowrap;font-size:12px;color:#626e85}td{border-bottom:1px solid #edeef4;padding:12px}td .btn{padding:6px 9px;font-size:12px;margin:2px}.muted{color:#8d96a7}.state{padding:5px 9px;border-radius:18px;font-size:12px}.active{background:#e6f7ed;color:#148350}.inactive{background:#fff0ef;color:#a64242}.grant-grid{min-height:56px;max-height:330px;overflow:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:14px}.grant{border:1px solid #e5e7f4;border-radius:11px;padding:11px 12px;display:flex;gap:8px;align-items:center;margin:0;cursor:pointer;font-size:14px}.grant input{accent-color:#6a51e5}.flash{padding:13px 18px;border-radius:12px;background:#e7f6ef;color:#175d3e;margin-bottom:20px;font-size:14px}.flash.error{background:#fff0ed;color:#b42e34}footer{font-size:12px;color:#8b95a8;text-align:center;margin-top:15px}@media(max-width:850px){.cols{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.grant-grid{grid-template-columns:repeat(2,1fr)}.top{flex-wrap:wrap}}@media(max-width:490px){.app{padding:18px 12px}.card{padding:17px}.grant-grid{grid-template-columns:1fr}.fieldrow{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}}
