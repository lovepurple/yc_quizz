    'Fehler bei der Generierung.': '生成失败。',
    'Fehler bei der KI-Generierung.': 'AI 出题失败。',
    'Bitte wähle eine PDF-Datei aus.': '请选择 PDF 文件。',
    'PDF ist zu groß (max 25 MB).': 'PDF 文件过大（最大 25 MB）。',
    'Bitte gib eine URL ein.': '请输入网页地址。',
    'Bitte gib einen Suchbegriff ein.': '请输入搜索关键词。',
    'Keine Textdaten erhalten.': '没有读取到文本内容。',
    'Quelle konnte nicht geladen werden.': '无法加载素材来源。',
    'z.B. Die Französische Revolution, Photosynthese, Römische Kaiserzeit...': '例如：网络协议分层、数据分包、算法…',
    'z.B. Albert Einstein': '例如：计算机网络',
    'Auto': '自动', 'Anz.': '数量',
    // 通用错误与数据校验
    'Wahr/Falsch-Fragen müssen genau zwei Antworten haben.': '判断题必须有两个选项。',
    'Jede Multiple-Choice-Frage muss mindestens eine richtige Antwort haben.': '每道选择题至少设置一个正确答案。',
    'Multiple-Choice-Fragen müssen mindestens zwei Antworten haben.': '选择题至少需要两个选项。',
    'Reihenfolge-Fragen müssen mindestens zwei Antworten haben.': '排序题至少需要两个答案。',
    'Schieberegler-Fragen müssen eine Konfiguration haben.': '滑块题需要设置正确数值。',
    'Schieberegler-Fragen müssen genau eine Antwort-Konfiguration haben.': '滑块题只能包含一组答案配置。',
    'Schieberegler-Fragen müssen einen korrekten Wert haben.': '滑块题需要填写正确数值。',
    'Schieberegler-Fragen müssen einen Min- und Max-Wert haben.': '滑块题需要设置最小值和最大值。',
    'Der Minimalwert muss kleiner als der Maximalwert sein.': '最小值必须小于最大值。',
    'Der korrekte Wert muss zwischen Min und Max liegen.': '正确数值应处于最小值与最大值之间。',
    'Der Schrittwert muss größer als 0 sein.': '步长必须大于0。',
    'Text-Fragen müssen mindestens eine akzeptierte Antwort haben.': '填空题至少需要一个可接受答案。',
    'Fehler beim Lesen der Datei.': '读取文件失败。',
    'Fehler beim Laden der Ergebnisse': '加载成绩失败',
    'Übungsquiz nicht gefunden': '未找到自主练习',
    'Übungsquiz nicht gefunden.': '未找到自主练习。',
    'Fehler beim Überprüfen des Übungsquiz': '检查自主练习失败',
    'Quiz erfolgreich geladen!': '测验加载成功！',
    'Lautstärke': '音量', 'Ton ausschalten': '关闭声音', 'Ton einschalten': '开启声音',
    'Ansicht wechseln': '切换视图'
  };

  // 特定数字/人名会变化的界面文案：只匹配完整的系统消息，避免误改学生答案。
  const rules = [
    [/^Antwort (\d+)$/, (_, n) => `答案 ${n}`],
    [/^Frage (\d+)$/, (_, n) => `第 ${n} 题`],
    [/^Frage (\d+) von (\d+)$/, (_, n, total) => `第 ${n} / ${total} 题`],
    [/^(\d+) Fragen$/, (_, n) => `${n} 道题`],
    [/^(\d+) Schüler$/, (_, n) => `${n} 名学生`],
    [/^(\d+) Teilnehmer$/, (_, n) => `${n} 人参与`],
    [/^(\d+) richtige Antworten$/, (_, n) => `答对 ${n} 题`],
    [/^Standard \((.+)\)$/, (_, v) => `默认（${translate(v)}）`],
    [/^Übungscode: (.+)$/, (_, code) => `练习码：${code}`],
    [/^Quiz-ID: (.+)$/, (_, code) => `测验编号：${code}`],
    [/^(\d+) Punkte bis zum nächsten Platz$/, (_, n) => `距离上一名还差 ${n} 分`],
    [/^(\d+) Plätze nach oben$/, (_, n) => `上升 ${n} 名`],
    [/^(\d+) Schüler benötigen Hilfe$/, (_, n) => `${n} 名学生需要帮助`],
    [/^(\d+) schwere Fragen$/, (_, n) => `${n} 道较难的题目`],
    [/^Frage (\d+): ([\d.]+)%$/, (_, n, p) => `第 ${n} 题：${p}%`],
    [/^Niedrige Klassenleistung: ([\d.]+)%$/, (_, p) => `班级平均正确率偏低：${p}%`],
    [/^Gute Klassenleistung: ([\d.]+)%$/, (_, p) => `班级平均正确率较好：${p}%`],
    [/^(\d+) einfach$/, (_, n) => `${n} 道简单题`],
    [/^(\d+) mittel$/, (_, n) => `${n} 道中等题`],
    [/^(\d+) schwer$/, (_, n) => `${n} 道难题`],
    [/^(\d+) Frage(?:n)? generiert!$/, (_, n) => `已生成 ${n} 道题！`],
    [/^Mindestens (\d+) Zeichen erforderlich$/, (_, n) => `至少需要 ${n} 个字符`],
    [/^Maximal (\d+) Zeichen erlaubt$/, (_, n) => `最多允许 ${n} 个字符`],
    [/^(\d+) Zeichen übrig$/, (_, n) => `还可输入 ${n} 个字符`],
    [/^Benutzer "(.+)" erstellt\.$/, (_, n) => `已创建用户“${n}”。`],
    [/^Benutzer "(.+)" gelöscht\.$/, (_, n) => `已删除用户“${n}”。`],
    [/^Benutzer "(.+)" wirklich löschen\?$/, (_, n) => `确定删除用户“${n}”吗？`],
    [/^(.+) hat das Spiel verlassen$/, (_, n) => `${n} 已退出测验`],
    [/^(.+) entfernen$/, (_, n) => `移除 ${n}`],
    [/^Charakter: (.+)\. Klicken zum Ändern$/, (_, n) => `当前角色：${n}。点击更换`],
    [/^Quiz darf maximal (\d+) Fragen enthalten\.$/, (_, n) => `一份测验最多允许 ${n} 道题。`],
    [/^Text-Fragen dürfen maximal (\d+) akzeptierte Antworten haben\.$/, (_, n) => `填空题最多支持 ${n} 个答案。`],
    [/^Reihenfolge-Fragen dürfen maximal (\d+) Antworten haben\.$/, (_, n) => `排序题最多支持 ${n} 个答案。`],
    [/^Multiple-Choice-Fragen dürfen maximal (\d+) Antworten haben\.$/, (_, n) => `选择题最多支持 ${n} 个选项。`],
    [/^Fragen dürfen maximal (\d+) Zeichen lang sein\.$/, (_, n) => `题目文字最多 ${n} 个字符。`],
    [/^Übungsquiz (.+)$/, (_, rest) => `自主练习 ${translate(rest)}`]
  ];

  // 显式跳过用户填写的内容、编辑区和代码块。
  const excluded = 'script,style,textarea,pre,code,[contenteditable="true"],[data-zh-no-translate]';
  const ATTRS = ['placeholder','title','aria-label','alt','data-tooltip'];
  function translate(s) {
    if (!s || typeof s !== 'string') return s;
    const trimmed = s.trim();
    if (!trimmed) return s;
    let result = Object.prototype.hasOwnProperty.call(translations, trimmed) ? translations[trimmed] : null;
    if (result == null) {
      for (const [pattern, action] of rules) {
        if (pattern.test(trimmed)) { result = trimmed.replace(pattern, (...args) => action(...args)); break; }
      }
    }
    if (result == null || result === trimmed) return s;
    return s.slice(0, s.length - s.trimStart().length) + result + s.slice(s.trimEnd().length);
  }
  function translateElement(el) {
    if (!(el instanceof Element) || el.closest(excluded)) return;
    for (const attr of ATTRS) {
      if (el.hasAttribute(attr)) {
        const before = el.getAttribute(attr);
        const after = translate(before);
        if (after !== before) el.setAttribute(attr, after);
      }
    }
    if (el instanceof HTMLInputElement && /^(button|submit|reset)$/.test(el.type)) {
      const after = translate(el.value);
      if (after !== el.value) el.value = after;
    }
  }
  function scan(root) {
    if (!root) return;
    if (root.nodeType === Node.TEXT_NODE) {
      if (!root.parentElement?.closest(excluded)) {
        const result = translate(root.nodeValue);
        if (result !== root.nodeValue) root.nodeValue = result;
      }
      return;
    }
    if (root.nodeType !== Node.ELEMENT_NODE && root.nodeType !== Node.DOCUMENT_NODE) return;
    if (root.nodeType === Node.ELEMENT_NODE) translateElement(root);
    const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT | NodeFilter.SHOW_ELEMENT);
    let node;
    while ((node = w.nextNode())) {
      if (node.nodeType === Node.TEXT_NODE) {
        if (!node.parentElement?.closest(excluded)) {
          const result = translate(node.nodeValue);
          if (result !== node.nodeValue) node.nodeValue = result;
        }
      } else if (node.nodeType === Node.ELEMENT_NODE) {
        translateElement(node);
      }
    }
  }
  let running = false;
  const pending = new Set();
  function flush() {
    running = false;
    const nodes = [...pending]; pending.clear();
    for (const node of nodes) if (node.isConnected || node.nodeType === Node.DOCUMENT_NODE) scan(node);
  }
  function enqueue(n) {
    if (!n) return;
    pending.add(n);
    if (!running) { running = true; queueMicrotask(flush); }
  }
  function initialize() {
    document.documentElement.lang = 'zh-CN';
    document.title = 'Quizzle · 中文课堂测验';
    const css = document.createElement('style');
    css.textContent = ':root,body,button,input,select,textarea{font-family:Inter,"Microsoft YaHei","PingFang SC","Noto Sans CJK SC",sans-serif!important}';
    document.head.appendChild(css);
    enqueue(document.body);
    const observer = new MutationObserver(mutations => {
      for (const m of mutations) {
        if (m.type === 'characterData') enqueue(m.target);
        else if (m.type === 'attributes') enqueue(m.target);
        else for (const added of m.addedNodes) enqueue(added);
      }
    });
    observer.observe(document.body, {subtree:true, childList:true, characterData:true, attributes:true, attributeFilter:ATTRS});
    console.info('[Quizzle 中文] 离线界面汉化补丁已启用（2.6.3）');
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize, {once:true});
  else initialize();
  // 用于不启动浏览器时检查文案映射的纯函数（不包含业务逻辑）。
  if (typeof module !== 'undefined' && module.exports) module.exports = {translate};
})();
