(()=>{'use strict';const $=id=>document.getElementById(id);const code=new URL(location.href).searchParams.get('code')||'';let current=null;
function tcell(tr,v){const td=document.createElement('td');td.textContent=String(v??'');tr.append(td);}
function csvField(v){const x=String(v??'');return /[",\r\n]/.test(x)?'"'+x.replace(/"/g,'""')+'"':x;}
function exportCSV(){if(!current)return;const rows=[['账号','姓名','班级','完成题数','题目总数','得分','更新时间'],...current.students.map(s=>[s.username,s.name,s.className,s.answers.length,s.total,s.score,s.timestamp])];const content='\uFEFF'+rows.map(x=>x.map(csvField).join(',')).join('\r\n');const u=URL.createObjectURL(new Blob([content],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=u;a.download='本班成绩_'+current.code+'.csv';a.click();URL.revokeObjectURL(u);}
$('exportBtn').onclick=exportCSV;
fetch('/api/school/admin/results/'+encodeURIComponent(code),{credentials:'same-origin',cache:'no-store'}).then(async r=>{const o=await r.json().catch(()=>({}));if(!r.ok)throw Error(o.message||'读取失败');return o;}).then(o=>{current=o;$('resultTitle').textContent=o.title;$('resultSubtitle').textContent='测验码：'+o.code+' · 班级：'+o.className;$('resultCards').textContent='参与 '+o.participated+' 人 · 已答完 '+o.completed+' 人 · 总题数 '+o.questions.length;$('exportBtn').disabled=false;const students=$('resultStudents'),questions=$('resultQuestions');for(const s of o.students){const tr=document.createElement('tr');[s.username,s.name,s.className,(s.answers.length+'/'+s.total),s.score,s.timestamp].forEach(v=>tcell(tr,v));students.append(tr);}for(const q of o.questions){const tr=document.createElement('tr');[q.number,q.title,q.answered,q.correct,q.incorrect,q.accuracy+'%'].forEach(v=>tcell(tr,v));questions.append(tr);}}).catch(e=>{$('resultTitle').textContent='无权查看或成绩暂不可用';$('resultError').classList.remove('hidden');$('resultError').textContent=e.message;});})();
